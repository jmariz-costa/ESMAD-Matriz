# Configuração local da Matriz. Copiar para backend/.env e alterar os valores.
# Todos os valores abaixo são fictícios. O ficheiro .env nunca vai para o Git (S08).
# IMPORTANTE: este ficheiro é público. Mudar as três palavras-passe (POSTGRES_PASSWORD,
# MATRIZ_ADMIN_PASSWORD e MATRIZ_DEMO_PASSWORD) antes do primeiro arranque; quem conhecer
# os valores de exemplo entra na base de dados e na aplicação (Ficha PL 04, S1).
# É lido pelo Backend em modo dev e pelos serviços postgres e backend do compose.yaml (Ficha PL 05).

# Base de dados (usada pelo contentor PostgreSQL e pelo Backend)
POSTGRES_DB=matriz
POSTGRES_USER=matriz
POSTGRES_PASSWORD=substituir-palavra-passe-da-bd

# Conta de Administrador, criada no arranque se ainda não existir (D07)
MATRIZ_ADMIN_NOME=Administrador
MATRIZ_ADMIN_EMAIL=admin@empresa.pt
MATRIZ_ADMIN_PASSWORD=substituir-palavra-passe-do-admin

# Dados de demonstração, criados no arranque se ainda não existirem Membros
MATRIZ_SEED_DEMO=true
MATRIZ_DEMO_PASSWORD=substituir-palavra-passe-demo

# Domínio de email das contas de Membro criadas pelo Administrador (US21), sem "@".
# Opcional: vazio ou ausente, o domínio não é verificado.
MATRIZ_DOMINIO_EMAIL=empresa.pt

# Sessão: pôr true quando a aplicação for servida por HTTPS (cookie Secure, D06)
MATRIZ_COOKIE_SEGURO=false
