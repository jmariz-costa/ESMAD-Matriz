# Configuração local da Matriz. Copiar para backend/.env e alterar os valores.
# Todos os valores abaixo são fictícios. O ficheiro .env nunca vai para o Git (S08).

# Base de dados (usada pelo contentor PostgreSQL e pelo Backend)
POSTGRES_DB=matriz
POSTGRES_USER=matriz
POSTGRES_PASSWORD=altere-esta-palavra-passe

# Conta de Administrador, criada no arranque se ainda não existir (D07)
MATRIZ_ADMIN_NOME=Administrador
MATRIZ_ADMIN_EMAIL=admin@empresa.pt
MATRIZ_ADMIN_PASSWORD=altere-esta-palavra-passe-admin

# Dados de demonstração, criados no arranque se ainda não existirem Membros
MATRIZ_SEED_DEMO=true
MATRIZ_DEMO_PASSWORD=demo-matriz-2026

# Sessão: pôr true quando a aplicação for servida por HTTPS (cookie Secure, D06)
MATRIZ_COOKIE_SEGURO=false
